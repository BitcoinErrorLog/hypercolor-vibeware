# Local Postgres from `docker compose up -d`.
# Railway injects DATABASE_URL from the Postgres plugin.
# vibeware:vibeware is local-only. Never reuse it on a reachable host.
DATABASE_URL=postgres://vibeware:vibeware@127.0.0.1:5432/vibeware

# Shared ingest password. No default in source. Fail closed if unset.
VIBEWARE_INGEST_TOKEN=

# Dashboard and projection password (read-only). No default in source. Fail closed if unset.
VIBEWARE_DASHBOARD_TOKEN=

# Internal mutate password (GC and generate guard). No default in source. Fail closed if unset.
VIBEWARE_INTERNAL_TOKEN=

# Opt-in only. Default false. Never inferred from the Host header.
VIBEWARE_ALLOW_QUERY_TOKEN_LOGIN=false

# Local http only. Cookie is Secure unless this is true (and not production / trusted https).
VIBEWARE_INSECURE_COOKIE=false

# Honor X-Forwarded-Proto and X-Forwarded-For from a configured proxy (e.g. Railway).
VIBEWARE_TRUST_PROXY=false

PORT=8080
